# Example config.ini for allsky360 camera daemon
#
# This is an example configuration for the Player-One Uranus-C with Sony IMX585
# and ZWO 2.1mm fisheye lens.
#

# General settings
######################
# Observing location - EDIT BEFORE STARTING THE SERVICES
# Decimal degrees, either with hemisphere suffix (N/S, E/W) or signed:
#   51.2349N = 51.2349      33.9249S = -33.9249
#   7.4479E  = 7.4479       74.0060W = -74.0060
# Invalid values are reported in the log and the default is used instead.
# location_altitude: metres above sea level
location_latitude=51.2349N
location_longitude=7.4479E
location_altitude=114
location_city="Musterstadt/Germany"
location_owner="Max Mustermann"
# Time zone of the station for display: the time printed into the image and
# the local time on the web pages (IANA name, list: timedatectl
# list-timezones). Empty = system time zone. Summer/winter time follows
# automatically. Everything stored (databases, images/YYYYMMDD, file names)
# is UTC, independent of this setting and of the system time zone.
location_timezone=Europe/Berlin
# config.json is served unauthenticated via /api/config and is readable by
# anyone who can reach the web interface. location_owner and the INDIGO server
# address are never included. The coordinates are, because the dashboard needs
# them - set this to 0 to publish them rounded to ~1 km instead.
publish_exact_location=1
# Capture intervall
capture_interval=120
# Directories
image_directory=/home/allskyuser/images
raw_dump_directory=/home/allskyuser/raw
video_directory=/home/allskyuser/videos
database_directory=/home/allskyuser/database

# Hook scripts
##############
# postprocessing_script runs after every image has been captured, processed
# and archived. It receives the absolute path of the archived JPEG as its
# first argument ($1) and additionally gets ALLSKY360_IMAGE_PATH,
# ALLSKY360_IMAGE_DIRECTORY, ALLSKY360_TODAY_STR, ALLSKY360_NOW_STR and
# ALLSKY360_IS_NIGHT in its environment. This is the place to run an AI model
# over the image, upload it somewhere, or anything else.
#
# endofnight_script runs once when the daemon switches from night to day and
# gets ALLSKY360_IMAGE_DIRECTORY, ALLSKY360_DATABASE_DIRECTORY and
# ALLSKY360_VIDEO_DIRECTORY. The shipped script builds the timelapse videos.
#
# Both run detached, as the same user as the daemon, and must be executable.
# Leave a value empty to disable that hook.
postprocessing_script=/opt/allsky360/scripts/postprocessing.sh
endofnight_script=/opt/allsky360/scripts/endofnight.sh

# Archive retention
###################
# Without this the archive grows without bound - at capture_interval=120 that
# is several GB per day. A day is always removed as a whole: the image
# directory images/YYYYMMDD (full images, thumbnails, panoramas, JSON), the
# timelapse videos <mode>_YYYYMMDD.mp4/.png, the INDIGO raw dumps in
# raw_dump_directory/YYYYMMDD and database_YYYYMMDD.db.
# retention=0 disables the cleanup entirely.
retention=1
# Maximum age in days.
retention_max_days=365
# Maximum size of the whole archive in GiB (images + videos + databases).
# Whichever limit is reached first wins. Leave headroom for the OS: on a
# 500 GB disk a limit of about 450 is the safer choice.
retention_max_size_gb=500
# Number of most recent days that are never deleted, whatever the limits say.
# Minimum (and default) 2, so a night spanning midnight is always safe.
retention_keep_days=2
# 1 = only report what would be deleted, delete nothing. Recommended for the
# first run after changing the limits.
retention_dry_run=0
# Node.js API
api-port=3000
# Listen address of the API/web server.
# 0.0.0.0 = all interfaces (default, reachable from the LAN)
# 127.0.0.1 = local only; use this together with a reverse proxy that adds TLS
#             and authentication if the station is reachable from the internet.
api-bind=0.0.0.0
# Shared secret for the privileged service-control endpoints
# (POST /api/services/{start,stop,restart}, header: X-API-Token).
#
# IMPORTANT: The Start/Stop/Restart buttons on the web configuration page
# only work when a token is set here. The browser asks for it on the first
# click and keeps it until the tab is closed.
#
# - Empty (default): service control is disabled (HTTP 403), fail closed.
# - Generate a token with:  openssl rand -hex 32
# - After changing it:      sudo systemctl restart allsky360-api.service
# - Read-only endpoints (images, graphs, status) never need the token.
# - The token is only read by the API; it is never written to config.json.
# - Without TLS the token travels in clear text through the LAN - see
#   api-bind above for running the API behind an HTTPS reverse proxy.
# Details: INSTALL.md ("Step 4: Set the API token") and API.md.
api-token=

# Indigo Server settings - EDIT BEFORE STARTING THE SERVICES
########################
# IP address or hostname of the Indigo server
indigo_server=192.168.3.61
# Port number of the Indigo server
indigo_port=7624
# Name under which allsky360 connects to the server. INDIGO reports the
# devices as "<device name> @ <indigo_servername>", so indigo_camera and
# indigo_mount below must end with " @ " plus this name.
indigo_servername=indigo_server
# Name of the Indigo camera to use. List the cameras with
#   /opt/allsky360/bin/indigo_cameras -h <indigo_server> -l
# or let ./install.sh pick it.
indigo_camera="Uranus-C @ indigo_server"
# Name of the Indigo mount device (leave empty if no mount is connected)
#   /opt/allsky360/bin/indigo_mount_position -c /home/allskyuser/config.ini -l
indigo_mount=
indigo_capture_timeout=30

# RS485 / Modbus RTU sensors (allsky360-sensors, run every 5 minutes by
# allsky360-sensors.timer). Values go into the table 'sensors' of the daily
# database and into allsky-api/public/latest_sensor_data.json.
# A sensor address of 0 disables that sensor; with all addresses 0 the tool
# does nothing. Example addresses of the reference station:
#   weather sensor 5, anemometer 11, wind vane 12, control cabinet 13
# Find the addresses on the bus with examples/modbus-scan.
######################
# Serial port and RS485 transceiver
modbus_device=/dev/ttyTHS1
modbus_baudrate=4800
# GPIO that switches the transceiver direction (DE/RE): high = send.
# Jetson: /dev/gpiochip0 line 112 (PR.04, UART1_RTS).
# -1 = transceiver with automatic direction control (e.g. USB-RS485 adapter)
modbus_gpio_chip=/dev/gpiochip0
modbus_gpio_line=112
# Wait for an answer (the sensors need up to ~1 s) and attempts per request
modbus_timeout_ms=1200
modbus_retries=3
# Read function: 3 = holding registers, 4 = input registers
modbus_function=3

# Weather sensor Halisense HLS-UWS-SDTHA: temperature, humidity, pressure,
# wind, noise, PM2.5/PM10, illuminance, rain (block from 0x01F4)
modbus_weather_address=0
modbus_weather_register=0x01F4
# Mounting correction of its wind direction, added modulo 360
modbus_weather_wind_direction_offset=0

# Anemometer: wind speed = raw value / scale in m/s
modbus_wind_speed_address=0
modbus_wind_speed_register=1
modbus_wind_speed_scale=1.0

# Wind vane: 0-359 degrees, offset = mounting correction added modulo 360
modbus_wind_direction_address=0
modbus_wind_direction_register=1
modbus_wind_direction_offset=0

# Temperature/humidity sensor in the control cabinet
# (humidity at the register, temperature at register + 1)
modbus_cabinet_address=0
modbus_cabinet_register=0

# Camera settings
#########################
camera_max_exposure=60.0
camera_min_exposure=0.0007
# Maximum and minimum automatic gain (depends on camera)
camera_max_gain=200
camera_min_gain=0
camera_binning2x2=0
camera_cooling=0
camera_cooling_temperature=5
# ROI is not implemented in the daemon yet - these keys have no effect.
#camera_roi_width=0
#camera_roi_height=0
#camera_roi_x=0
#camera_roi_y=0
# Debayer algorithm: nni, bilinear or vng
camera_debayer=vng

# Lens
######
lens_name="ZWO 2.1mm f/2.0"
lens_focallength=2.1
lens_focalratio=1.6

# Image settings
######################
# JPEG quality (0...100 %)
jpeg_quality=100
# Center of the image
image_center_x=1925
image_center_y=1185
# mask_radius set to 0 disables masking
image_mask_radius=1090
# Zenith position
image_zenith_x=1925
image_zenith_y=1185
image_horizon_radius=1090
image_north_angle=-11.0

# Focus measurement
###################
focus_radius=200

# Crop image
############
crop_image=1
crop_width=2280
crop_height=2180
crop_x_offset=760
crop_y_offset=0
rotate_image=0

# Panorama (horizon view)
#########################
# Enable/Disable panorama generation
panorama=1
panorama_center_x=1144
panorama_center_y=1180
panorama_width=3048
panorama_height=1090
panorama_horizontal_start=260

# Daytime settings
####################
# Take images during daytime
daytime_capture=1
# Exposure and gain after leaving night mode or at start
daytime_startexposure=0.0045
daytime_startgain=0
# Auto-exposure settings
daytime_meanbrightness=0.20
# White balance
daytime_white_balance_blue=1.4
daytime_white_balance_red=1.0
# Move blackpoint
daytime_move_blackpoint=0.01
daytime_move_blackpoint_min_shift_pct=0.005
daytime_move_blackpoint_max_shift_pct=0.02
daytime_move_blackpoint_dark_threshold=0.2
# HDR exposure factor (should be 1.0 or 2.0 for good results)
daytime_hdr_exposure_factor=2.0

# Nighttime settings
####################
# Altitude of the Sun in degrees relative to the horizon at which to switch between day and night.
nighttime_sunangle=-6
# Exposure and gain when entering night mode or at start
nighttime_startexposure=10.0
nighttime_startgain=0
# Auto-expousre settings
nighttime_meanbrightness=0.15
# White balance
nighttime_white_balance_blue=2.0
nighttime_white_balance_red=1.0
# Green cast reduction / light pollution reduction
scnr_filter=1
scnr_filter_amount=0.5
# Protection modes (none, average_neutral, maximum_neutral)
scnr_filter_protection=average_neutral
# Move blackpoint
nighttime_move_blackpoint=0.001
nighttime_move_blackpoint_min_shift_pct=0.005
nighttime_move_blackpoint_max_shift_pct=0.02
nighttime_move_blackpoint_dark_threshold=0.2
# HDR exposure factor (should be 1.0 or 2.0 for good results)
nighttime_hdr_exposure_factor=2.0
# Noise estimation
nighttime_measure_noise=1
nighttime_measure_noise_radius=250

# Brightness measurement for auto-exposure
##########################################
# Radius of the measured area as a fraction (0.0 - 1.0) of image_horizon_radius.
# 0.55 * 1090 px = ~600 px
measure_brightness_area=0.55

# Multiscale Median Filter (reduce noise at high gains)
#######################################################
# max_scale | blend_factor | Effect
# ----------|--------------|-----------------------------------------------------------
#    1      |     0.3      | Slight smoothing of fine noise, stars remain sharp.
#    1      |     1.0      | Strong removal of fine noise structures.
#    2      |     0.3      | Moderate smoothing, removes small hot pixels, stars stay visible.
#    2      |     0.7      | Noticeable smoothing, weaker stars may fade.
#    3      |     0.5      | Strong smoothing, background becomes very uniform, stars soften.
#    3      |     1.0      | Very strong smoothing, image looks blurred/soft.
nighttime_multiscale_median_filter=1
nighttime_multiscale_median_filter_max_scale=2
nighttime_multiscale_median_filter_amount=0.9

# HDR settings
##############
hdr=1
# Clipping threshold depends on sensor bit depth
hdr_clipping_threshold=0.99998
hdr_min_clipped_pixels=0.00001
# Value between 1.2 and 1.4
hdr_y_max_expected=1.0
hdr_weight_sigma=0.8
hdr_weight_clip_factor=0.90
hdr_contrast_weight_strength=0.6
# 0 = off, 1 = full: downweight short exposures where linearized luma is
# within noise (uses per-frame sigma_noise from background MAD; no effect if unset)
hdr_noise_fusion_strength=1.0
# 1..6, 0 = automatic
hdr_pyramid_levels_override=0
# HDR debugging
hdr_weight_maps=0
hdr_weight_stats=1
hdr_save_exposures=1

# HDR multiscale transform (experimental)
#########################################
hdrmt=0

# Spektralanalyse (experimentell)
###################################
# Grobe Spektralrekonstruktion aus RGB-Kanalwerten via Wiener-Schaetzung
# (IMX585-QE-Kurven, effektiv 3 Freiheitsgrade - nur als Fingerabdruck verwenden)
spektrum_enabled=0
# Messzentrum in Pixeln (-1 = Bildmitte)
spektrum_cx=-1
spektrum_cy=-1
# Messradius in Pixeln (1..100)
spektrum_radius=50
# Tikhonov-Regularisierungsparameter (hoeher = glatteres Spektrum)
spektrum_regularization=0.01
# Ausgabepfad fuer spektrum.json
spektrum_output_path=images/spektrum.json

# Autostretch
##########################
# Use autostretch instead of nighttime_move_blackpoint or daytime_move_blackpoint
autostretch=1
autostretch_min_val=0.01
autostretch_max_val=0.99

# Adaptive Contrast‑Driven Noise Reduction Filter
#################################################
acdnr_filter=1
acdnr_filter_lum_stddev=1.5
acdnr_filter_lum_amount=0.15
acdnr_filter_lum_iterations=2
acdnr_filter_lum_kernel_size=3
acdnr_filter_chrom_stddev=2.0
acdnr_filter_chrom_amount=0.4
acdnr_filter_chrom_iterations=2
acdnr_filter_chrom_kernel_size=5

# Gamma
#######
# default = 0.8, >1.0 darken foreground areas, <1.0 brighten background areas
gamma=0.9

# Auto-Gamma + Reinhard Tone Mapping
######################################
# auto_gamma=1: gamma is computed automatically from scene mean luminance so
# that the average brightness maps to auto_gamma_target (middle grey = 0.18).
# auto_gamma=0: fixed gamma value above is used.
auto_gamma=0
auto_gamma_target=0.18
auto_gamma_min=0.15
auto_gamma_max=1.2
# reinhard_tonemap=1: apply Reinhard global TMO after gamma.
# reinhard_white_point=0: auto-detect (output max = 255).
# reinhard_white_point>0: map this luminance value to full white.
reinhard_tonemap=0
reinhard_white_point=0.0

# Tone Curve (S-Curve)
#######################
# Parametric S-curve applied in luminance space after gamma/Reinhard.
# tone_curve=1 enables the correction; tone_curve=0 disables it.
#
# shadow_lift     [0.0 – 0.5]: raises shadows and lower midtones.
#                 Bell curve peaking at Y≈0.33; blacks stay black.
#                 Typical: 0.10 (subtle) … 0.30 (strong lift)
#
# midtone_contrast [0.0 – 0.5]: classic S-curve pivot at Y=0.5.
#                 Lifts lower half, compresses upper half → more punch.
#                 Typical: 0.15 (subtle) … 0.40 (strong contrast)
tone_curve=0
tone_curve_shadow_lift=0.20
tone_curve_midtone_contrast=0.30

# Saturation
############
# default = 2.8 (3x coloration), 1.0 no change, >1.0 more color, <1.0 less color
saturation=2.0

# Dehaze Filter
###############
# default = 0.8, 0.0 = disabled
dehaze_amount=0.0
dehaze_estimate=0.01
dehaze_gamma=0.6
dehaze_saturation=1.2

# Clarity Filter
################
clarity_filter=0
clarity_filter_strength=0.35
clarity_filter_radius=24
clarity_filter_midtone_width=0.25
clarity_filter_preserve_highlights=1
clarity_filter_mask_mode=1

# Automatic color calibration and background neutralization
###########################################################
# Set auto_color_calibration_area=0.0 to disable
auto_color_calibration_area=80.0

# Wavelet Sharpening
####################
wavelet_sharpen=1
wavelet_sharpen_gain_small=2.0
wavelet_sharpen_gain_medium=0.0
wavelet_sharpen_gain_large=0.0

# SQM estimation
################
# Stars are detected on the raw frame of HDR frame 0 (the longest exposure),
# before debayering and any processing, inside the circle sqm_center_x/y,
# sqm_radius (processing-image pixels, i.e. after the crop; 0 = image_zenith).
# Only at exposures > 1 s; the star list goes to images/YYYYMMDD/stars-*.json
# (position, flux, SNR, FWHM) and the count into the database.
sqm=1
sqm_max_stars=1000
sqm_radius=100
sqm_center_x=989
sqm_center_y=1238
# Gaussian sigma of a star in image pixels (FWHM / 2.355). The mean "fwhm"
# in the stars-*.json files shows the real value; typical 1.0-1.5.
sqm_star_sigma=1.0
# Detection threshold in noise sigma of the filtered image. 5 gives about 1 %
# false detections on real night frames; lower finds fainter stars and more
# noise, higher only bright stars.
sqm_detect_sigma=5.0
# Rejected as not a star: wider than sqm_max_fwhm image pixels (lights, lit
# clouds) or more elongated than sqm_max_elongation (0 = round, 1 = line:
# edges, wires, trails).
sqm_max_fwhm=8.0
sqm_max_elongation=0.5
# The star count depends on the detector: after changing the parameters
# above, recalibrate sqm_intercept against a known value (SQM-L meter or
# lightpollutionmap.info) on a clear moonless night.
# the intercept representing the maximum sky darkness
# You can get the value from lightpollutionmap.info for your location
sqm_intercept=21.2
# slope is controlling the sensitivity of the SQM estimate to the detected star count
sqm_slope=1.5





