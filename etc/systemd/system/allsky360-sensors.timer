[Unit]
Description=Read the RS485/Modbus sensors every 5 minutes

[Timer]
OnBootSec=2min
# OnUnitActiveSec counts from the last run of the service, which systemd
# forgets on daemon-reload: without this the timer never fires again after
# a restart (make install) until the next boot.
OnActiveSec=1min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=allsky360-sensors.service

[Install]
WantedBy=timers.target
