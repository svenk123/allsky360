[Unit]
Description=Allsky360 Node.js API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default values (can be overridden via EnvironmentFile)
Environment=NODE_BIN=/usr/bin/node
Environment=APP_DIR=/opt/allsky360/allsky-api
Environment=CONFIG_PATH=/home/allskyuser/config.ini
User=allskyuser
Group=allskygroup
# Optional: load overrides from env file
EnvironmentFile=-/etc/allsky360/env
WorkingDirectory=/opt/allsky360/allsky-api
ExecStart=/usr/bin/node /opt/allsky360/allsky-api/index.js --config /home/allskyuser/config.ini
Restart=always
RestartSec=3

# --- Sandbox (review.md, SEC-09) ------------------------------------------
# The API only reads files (config, images, videos, databases) and starts/
# stops services through systemctl -> D-Bus -> polkit
# (/etc/polkit-1/rules.d/50-allsky360.rules). It does not use sudo any more:
# a setuid program cannot run under NoNewPrivileges, which most of the
# options below imply anyway.
# Check the result with: systemd-analyze security allsky360-api.service
NoNewPrivileges=yes
# Ports below 1024 would need CAP_NET_BIND_SERVICE here (and in
# AmbientCapabilities=); the default port 3000 needs none.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# Other users' homes are hidden. The data of allskyuser is mapped in
# read-only, except the database directory: SQLite needs to create/update the
# -shm file to read a WAL database, even when it is opened read-only.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/allskyuser
BindPaths=/home/allskyuser/database
PrivateTmp=yes
PrivateDevices=yes
# No ProtectProc=invisible: /api/aircraft/status runs "pgrep dump1090",
# which has to see processes of other users.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute=: Node.js (V8) compiles JavaScript to machine
# code at runtime and needs writable+executable memory.
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=multi-user.target
