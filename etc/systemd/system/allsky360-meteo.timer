[Unit]
Description=Run allsky360-meteo every 30 minutes

[Timer]
OnBootSec=2min
# OnUnitActiveSec counts from the last run of the service, which systemd
# forgets on daemon-reload: without this the timer never fires again after
# a restart (make install) until the next boot.
OnActiveSec=1min
# The models are recomputed every 1-3 hours, the current values come from
# the station sensors (allsky360-sensors): 30 minutes are enough
OnUnitActiveSec=30min
AccuracySec=30s
Persistent=true
Unit=allsky360-meteo.service

[Install]
WantedBy=timers.target
