[Unit]
Description=Allsky360 RS485/Modbus sensors (wind every 10 s, a reading every 5 minutes)

[Service]
# Runs continuously: anemometer and wind vane are sampled every
# modbus_wind_sample_interval seconds into a ring buffer in RAM, one row per modbus_interval goes to the database (see
# docs/TOOLS.md). Replaces the former allsky360-sensors.timer.
Type=simple
User=allskyuser
Group=allskygroup
WorkingDirectory=/home/allskyuser/database
ExecStart=/opt/allsky360/bin/allsky360-sensors --daemon -c /home/allskyuser/config.ini -d /home/allskyuser/database -f /opt/allsky360/allsky-api/public/latest_sensor_data.json
# Bus or GPIO not available (e.g. USB adapter unplugged): try again later
Restart=on-failure
RestartSec=30

# --- Sandbox (review.md, SEC-09) ------------------------------------------
# Like the other fetch tools, but instead of PrivateDevices= an allow list
# for the serial port and the GPIO chip of the RS485 direction line.
# allskyuser needs the groups dialout and gpio (make install adds them).
# Check the result with: systemd-analyze security allsky360-sensors.service
DevicePolicy=closed
DeviceAllow=char-ttyTHS rw
DeviceAllow=char-ttyS rw
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-gpiochip rw
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/home/allskyuser/database /opt/allsky360/allsky-api/public
# Other users' homes are hidden, only allskyuser's files are mapped in
ProtectHome=tmpfs
BindReadOnlyPaths=/home/allskyuser/config.ini
BindPaths=/home/allskyuser/database
PrivateTmp=yes
PrivateNetwork=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=multi-user.target
