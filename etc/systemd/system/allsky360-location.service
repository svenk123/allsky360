[Unit]
Description=Allsky360 fetch: location (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=allskyuser
Group=allskygroup
WorkingDirectory=/home/allskyuser/database
ExecStart=/opt/allsky360/bin/allsky360-location -c /home/allskyuser/config.ini -d /home/allskyuser/database

# --- Sandbox (review.md, SEC-09) ------------------------------------------
# Fetch tool: needs network, reads config.ini, writes only the paths below.
# Check the result with: systemd-analyze security allsky360-location.service
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/home/allskyuser/database
# Other users' homes are hidden, only allskyuser's files are mapped in
ProtectHome=tmpfs
BindReadOnlyPaths=/home/allskyuser/config.ini
BindPaths=/home/allskyuser/database
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0022
